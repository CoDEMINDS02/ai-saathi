generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("OWNER")
  createdAt    DateTime @default(now())
}

model Product {
  id           String     @id @default(cuid())
  name         String
  sku          String     @unique
  stock        Int
  reorderLevel Int
  reorderQty   Int        @default(20)
  price        Int
  saleItems    SaleItem[]
}

model Customer {
  id        String        @id @default(cuid())
  name      String
  phone     String?
  sales     Sale[]
  credits   CreditEntry[]
  reminders Reminder[]
}

model Sale {
  id          String     @id @default(cuid())
  date        DateTime   @default(now())
  total       Int
  paymentType String
  customerId  String?
  customer    Customer?  @relation(fields: [customerId], references: [id])
  items       SaleItem[]
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  unitPrice Int
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model CreditEntry {
  id         String    @id @default(cuid())
  customerId String
  amount     Int
  paidAmount Int       @default(0)
  dueDate    DateTime
  status     String    @default("PENDING")
  createdAt  DateTime  @default(now())
  customer   Customer  @relation(fields: [customerId], references: [id])
}

model Reminder {
  id         String    @id @default(cuid())
  customerId String
  message    String
  status     String    @default("DRAFT")
  createdAt  DateTime  @default(now())
  approvedAt DateTime?
  customer   Customer  @relation(fields: [customerId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  userId    String?
  createdAt DateTime @default(now())
}